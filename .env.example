# Clinexa — Agentic Primary-Care Voice Assistant. Copy to .env and fill in. Never commit .env.

# --- Application ---------------------------------------------------------
ENVIRONMENT=local
LOG_LEVEL=INFO
# false = human-readable console logs for local dev
LOG_JSON=false
# Logs caller transcript text. Only enable locally with synthetic callers.
LOG_TRANSCRIPTS=true

# Public HTTPS origin Twilio can reach (e.g. `ngrok http 8000`). No trailing slash.
PUBLIC_BASE_URL=https://your-subdomain.ngrok-free.app

# --- Twilio --------------------------------------------------------------
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your-twilio-auth-token
# Keep true everywhere except throwaway local experiments.
TWILIO_VALIDATE_SIGNATURES=true
TWILIO_SAY_VOICE=Polly.Joanna-Neural

# HMAC secret binding each Media Stream to its verified webhook.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
# Required when running more than one API instance (otherwise random per process).
STREAM_TOKEN_SECRET=

# --- Deepgram (streaming STT) ---------------------------------------------
DEEPGRAM_API_KEY=your-deepgram-api-key
DEEPGRAM_STT_MODEL=nova-3
DEEPGRAM_LANGUAGE=en-US
DEEPGRAM_ENDPOINTING_MS=300
DEEPGRAM_UTTERANCE_END_MS=1000
# JSON list of domain terms to boost (Nova-3 keyterm prompting)
DEEPGRAM_KEYTERMS=["paracetamol","ibuprofen","amoxicillin","shortness of breath"]

# --- Conversation -----------------------------------------------------------
EMERGENCY_NUMBER_PHRASE=your local emergency number

# --- LLM: Anthropic Claude (Phase 2+) ----------------------------------------
# Leave blank to run transcription-only (no spoken replies).
ANTHROPIC_API_KEY=your-anthropic-api-key
ANTHROPIC_MODEL=claude-opus-5-5
# Thinking depth: low | medium | high. Low keeps time-to-first-token short.
LLM_EFFORT=low
# Re-run a request declined by a safety classifier on Anthropic's fallback model.
# For models without effort / fallback support (e.g. claude-haiku-4-5) set
# LLM_EFFORT= (blank) and LLM_REFUSAL_FALLBACK=false.
LLM_REFUSAL_FALLBACK=true

# --- TTS: Deepgram Aura (Phase 2) — reuses DEEPGRAM_API_KEY ---------------------
DEEPGRAM_TTS_MODEL=aura-2-thalia-en

# --- Qdrant vector DB (Phase 6) ---------------------------------------------
# Local Docker: http://localhost:6333 with no API key.
# Qdrant Cloud: https://<cluster-id>.<region>.cloud.qdrant.io:6333 plus an API key.
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=clinexa_who_primary_care

# --- Local retrieval models (Phases 6–8): downloaded from Hugging Face, no key needed ---
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# --- PostgreSQL + Redis (Phase 13): local Docker, no keys ------------------------
DATABASE_URL=postgresql+asyncpg://clinexa:clinexa@localhost:5432/clinexa
REDIS_URL=redis://localhost:6379/0

# --- Observability: Pydantic Logfire (Phase 14) -------------------------------
# Project write token: Logfire → project → Settings → Write tokens.
LOGFIRE_TOKEN=your-logfire-write-token
LOGFIRE_SERVICE_NAME=clinexa-api
# Route LangGraph/LangChain traces into Logfire via OpenTelemetry (no LangSmith key needed)
LANGSMITH_OTEL_ENABLED=true
LANGSMITH_OTEL_ONLY=true
LANGSMITH_TRACING=true
