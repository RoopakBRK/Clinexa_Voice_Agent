# CareFlow AI — copy to .env and fill in. Never commit .env.

# --- Application ---------------------------------------------------------
ENVIRONMENT=local
LOG_LEVEL=INFO
# false = human-readable console logs for local dev
LOG_JSON=false
# Logs caller transcript text. Only enable locally with synthetic callers.
LOG_TRANSCRIPTS=true

# Public HTTPS origin Twilio can reach (e.g. `ngrok http 8000`). No trailing slash.
PUBLIC_BASE_URL=https://your-subdomain.ngrok-free.app

# --- Twilio --------------------------------------------------------------
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your-twilio-auth-token
# Keep true everywhere except throwaway local experiments.
TWILIO_VALIDATE_SIGNATURES=true
TWILIO_SAY_VOICE=Polly.Joanna-Neural

# HMAC secret binding each Media Stream to its verified webhook.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
# Required when running more than one API instance (otherwise random per process).
STREAM_TOKEN_SECRET=

# --- Deepgram (streaming STT) ---------------------------------------------
DEEPGRAM_API_KEY=your-deepgram-api-key
DEEPGRAM_STT_MODEL=nova-3
DEEPGRAM_LANGUAGE=en-US
DEEPGRAM_ENDPOINTING_MS=300
DEEPGRAM_UTTERANCE_END_MS=1000
# JSON list of domain terms to boost (Nova-3 keyterm prompting)
DEEPGRAM_KEYTERMS=["paracetamol","ibuprofen","amoxicillin","shortness of breath"]

# --- Conversation -----------------------------------------------------------
EMERGENCY_NUMBER_PHRASE=your local emergency number
