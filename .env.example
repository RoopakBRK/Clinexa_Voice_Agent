# Clinexa — Agentic Primary-Care Voice Assistant. Copy to .env and fill in. Never commit .env.

# --- Application ---------------------------------------------------------
ENVIRONMENT=local
LOG_LEVEL=INFO
# false = human-readable console logs for local dev
LOG_JSON=false
# Logs caller transcript text. Only enable locally with synthetic callers.
LOG_TRANSCRIPTS=true

# Public HTTPS origin Twilio can reach (e.g. `ngrok http 8000`). No trailing slash.
PUBLIC_BASE_URL=https://your-subdomain.ngrok-free.app

# --- Twilio --------------------------------------------------------------
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your-twilio-auth-token
# Keep true everywhere except throwaway local experiments.
TWILIO_VALIDATE_SIGNATURES=true
TWILIO_SAY_VOICE=Polly.Joanna-Neural

# HMAC secret binding each Media Stream to its verified webhook.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
# Required when running more than one API instance (otherwise random per process).
STREAM_TOKEN_SECRET=

# --- Web onboarding channel (Clinexsa website) ----------------------------
# Browser origins allowed to start an onboarding session with Roopiee (JSON list).
WEB_ALLOWED_ORIGINS=["http://localhost:3000","http://localhost:3210"]
# Seconds the single-use token from POST /web/session stays valid.
WEB_TOKEN_TTL_S=60
# A session with no speech and no form activity for this long is closed.
WEB_IDLE_TIMEOUT_S=900
# Sessions one IP address may start per minute.
WEB_SESSIONS_PER_MINUTE=10

# --- Deepgram (streaming STT) ---------------------------------------------
DEEPGRAM_API_KEY=your-deepgram-api-key
DEEPGRAM_STT_MODEL=nova-3
DEEPGRAM_LANGUAGE=en-US
DEEPGRAM_ENDPOINTING_MS=300
DEEPGRAM_UTTERANCE_END_MS=1000
# JSON list of domain terms to boost (Nova-3 keyterm prompting). Leave unset to use the
# built-in list of common Indian medicine names (app/core/config.py).
# DEEPGRAM_KEYTERMS=["Paracetamol","Dolo 650","Glycomet","shortness of breath"]

# --- Conversation -----------------------------------------------------------
EMERGENCY_NUMBER_PHRASE=your local emergency number

# --- LLM: Anthropic Claude (Phase 2+) ----------------------------------------
# Leave blank to run transcription-only (no spoken replies).
ANTHROPIC_API_KEY=your-anthropic-api-key
ANTHROPIC_MODEL=claude-opus-5-5
# Thinking depth: low | medium | high. Low keeps time-to-first-token short.
LLM_EFFORT=low
# Re-run a request declined by a safety classifier on Anthropic's fallback model.
# For models without effort / fallback support (e.g. claude-haiku-4-5) set
# LLM_EFFORT= (blank) and LLM_REFUSAL_FALLBACK=false.
LLM_REFUSAL_FALLBACK=true
# How many times in one reply Claude may look something up before it has to answer.
LLM_MAX_TOOL_ROUNDS=3

# --- TTS: Deepgram Aura (Phase 2) — reuses DEEPGRAM_API_KEY ---------------------
DEEPGRAM_TTS_MODEL=aura-2-thalia-en

# --- Qdrant vector DB (Phase 6) ---------------------------------------------
# Local Docker: http://localhost:6333 with no API key.
# Qdrant Cloud: https://<cluster-id>.<region>.cloud.qdrant.io:6333 plus an API key.
# Both collections below live on this one server. Fill them with `make index` (WHO
# guidance) and `make medicines` (the medicines catalogue).
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=clinexa_who_primary_care

# --- Lookups during a call ------------------------------------------------------
# WHO guidance: dense + BM25, RRF, cross-encoder. Unset QDRANT_URL to use the embedded
# local index instead (data/indexes/qdrant, filled by `make index ARGS="--local"`).
GUIDELINES_RETRIEVAL=true
# Seconds a caller is kept waiting on a search before Claude is told nothing was found.
GUIDELINES_TIMEOUT_S=4.0

# Indian medicines catalogue: National List of Essential Medicines 2022, Jan Aushadhi and
# the A to Z medicines dataset of India. Needs QDRANT_URL: a quarter of a million names
# are too many for the embedded local index.
MEDICINES_LOOKUP=true
MEDICINES_COLLECTION=clinexa_medicines
MEDICINES_LOOKUP_TIMEOUT_S=1.5
# Also search names with a bi-encoder and order them with a cross-encoder. Off: measured
# on the whole catalogue they did not change which medicine is found (docs/rag.md).
# Turning it on means indexing again: make medicines ARGS="--recreate".
MEDICINES_ENCODERS=false

# --- Local retrieval models (Phases 6–8): downloaded from Hugging Face, no key needed ---
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# --- PostgreSQL + Redis (Phase 13): local Docker, no keys ------------------------
DATABASE_URL=postgresql+asyncpg://clinexa:clinexa@localhost:5432/clinexa
REDIS_URL=redis://localhost:6379/0

# --- Tracing: Pydantic Logfire, over OpenTelemetry (app/observability/tracing.py) ---
# Leave LOGFIRE_TOKEN blank and no trace is sent anywhere. With it, each call is traced:
# its replies, its requests to Claude and its lookups, with timings and outcomes. What a
# caller says, tool arguments, headers and endpoint arguments are never put in a trace.
# Project write token: Logfire → project → Settings → Write tokens.
LOGFIRE_TOKEN=your-logfire-write-token
LOGFIRE_SERVICE_NAME=clinexa-api
# Route LangGraph/LangChain traces into Logfire via OpenTelemetry (no LangSmith key needed)
LANGSMITH_OTEL_ENABLED=true
LANGSMITH_OTEL_ONLY=true
LANGSMITH_TRACING=true

# --- Exotel: patient alerts (WhatsApp messages and voice calls) ----------------
# Separate from sign-in. Leave blank to keep alerts off.
# From https://my.exotel.com/apisettings/site#api-credentials
EXOTEL_API_KEY=
EXOTEL_API_TOKEN=
EXOTEL_ACCOUNT_SID=
# Mumbai cluster. Singapore is api.exotel.com.
EXOTEL_SUBDOMAIN=api.in.exotel.com
# The ExoPhone (virtual number) reminder calls come from.
EXOTEL_CALLER_ID=
# The flow (app id) whose Voicebot applet URL is
#   wss://<EXOTEL_STREAM_USERNAME>:<EXOTEL_STREAM_PASSWORD>@<public host>/exotel/stream
EXOTEL_VOICE_APP_ID=
# The WhatsApp Business number messages come from, with country code (+91...).
EXOTEL_WHATSAPP_FROM=
# Templates, approved on Exotel first. Body variables, in order:
#   dose reminder: {{1}} first name, {{2}} medicine, {{3}} time
#   low stock:     {{1}} first name, {{2}} medicine, {{3}} days left
EXOTEL_DOSE_TEMPLATE=clinexsa_dose_reminder
EXOTEL_LOW_STOCK_TEMPLATE=clinexsa_low_stock
EXOTEL_TEMPLATE_LANGUAGE=en
# What Exotel must present to us. Make these up; they are not your Exotel API keys.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(24))"
EXOTEL_STREAM_USERNAME=
EXOTEL_STREAM_PASSWORD=
EXOTEL_CALLBACK_KEY=

# --- Supabase server key (alerts worker only) ---------------------------------
# The service-role key bypasses row-level security. Keep it here and nowhere else:
# never in the website, never in a browser, never in git.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# The website's publishable key (the same value as NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY).
# With SUPABASE_URL it lets POST /web/session check the caller is signed in to the website.
# Required when ENVIRONMENT=production: without it nobody can start a session.
SUPABASE_PUBLISHABLE_KEY=

# --- Alerts worker -------------------------------------------------------------
# Switch on only after Exotel, Supabase and the templates are ready.
ALERTS_ENABLED=false
# Bearer token your scheduler sends to POST /jobs/alerts/run (every minute)
# and POST /jobs/low-stock/run (once a day).
ALERTS_JOBS_TOKEN=
# true = this server checks for due reminders every minute by itself.
# false = an external cron calls the two /jobs endpoints instead.
ALERTS_SCHEDULER=true
ALERTS_LOW_STOCK_HOUR=10
ALERTS_TIMEZONE=Asia/Kolkata
ALERTS_WINDOW_MIN=5
